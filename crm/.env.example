# Base de datos. En producción usa PostgreSQL (Render, Railway, Supabase, Neon...)
DATABASE_URL=postgresql://usuario:clave@host:5432/crm
# En local (sin HTTPS) pon false para que funcione el inicio de sesión
COOKIE_SECURE=true
SESSION_DAYS=30
# Solo para importar desde Monday (Monday → foto de perfil → Desarrolladores → Mi token de acceso)
MONDAY_API_TOKEN=
