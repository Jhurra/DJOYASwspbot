# --- WhatsApp Cloud API (Meta) ---
ACCESS_TOKEN=            # Token permanente de un usuario del sistema
APP_SECRET=              # Secreto de la app (valida la firma X-Hub-Signature-256)
VERIFY_TOKEN=            # Texto que inventas y pones también en la config del webhook en Meta
PHONE_NUMBER_ID=
VERSION=v21.0

# --- OpenAI (Responses API) ---
OPENAI_API_KEY=
# Opción A (recomendada): Prompt creado en platform.openai.com con modelo, instrucciones y file_search
OPENAI_PROMPT_ID=
OPENAI_PROMPT_VERSION=
# Opción B: sin Prompt (se ignora si OPENAI_PROMPT_ID está definido)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INSTRUCTIONS=
OPENAI_VECTOR_STORE_ID=
# Horas sin mensajes tras las que se abre una conversación nueva
CONVERSATION_TTL_HOURS=10

# --- Base de datos ---
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos
